{
  "name": "smartmanager-loyalty-license-generator",
  "productName": "SmartManager Loyalty License Generator",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop tool that issues digitally signed SmartManager Loyalty licenses.",
  "author": "SmartManager",
  "main": "out/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:main && vite build --watch & electron .",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "tsc --noEmit && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@smloyalty/license-core": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.smartmanager.loyalty.licensegenerator",
    "productName": "SmartManager Loyalty License Generator",
    "electronVersion": "33.4.11",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": ["portable", "nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.business" },
    "linux": { "target": ["AppImage"], "category": "Office" }
  }
}
