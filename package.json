{
  "name": "smartmanager-loyalty-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "SmartManager Loyalty: offline-first mobile app + separate offline License Generator desktop tool",
  "workspaces": [
    "packages/license-core",
    "app",
    "license-generator"
  ],
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "npm install",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:app": "npm run build -w app",
    "build:generator": "npm run build -w license-generator",
    "check:no-private-key": "node scripts/check-no-private-key.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  }
}
